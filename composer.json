{
    "name": "conduit-ui/cloudflare",
    "description": "Cloudflare management CLI for the Conduit agent ecosystem",
    "keywords": [
        "cli",
        "cloudflare",
        "conduit-ui"
    ],
    "homepage": "https://github.com/conduit-ui/cloudflare",
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/conduit-ui/cloudflare/issues",
        "source": "https://github.com/conduit-ui/cloudflare"
    },
    "authors": [
        {
            "name": "Jordan Partridge",
            "email": "jordan@partridge.rocks"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/framework": "^13.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25.1",
        "mockery/mockery": "^1.6.12",
        "pestphp/pest": "^3.8.4|^4.1.2",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.33"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": [
        "cf"
    ],
    "scripts": {
        "build": "php -d phar.readonly=0 cf app:build cf",
        "test": "pest"
    }
}
